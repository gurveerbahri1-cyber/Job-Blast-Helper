# Clerk Authentication (Frontend)
# Get your publishable key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Optional: Clerk proxy URL if using custom domain proxying
# VITE_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# Port and Base URL (optional)
PORT=3000
BASE_PATH=/
